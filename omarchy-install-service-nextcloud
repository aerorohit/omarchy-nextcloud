#!/bin/bash

# omarchy:summary=Install and start the Nextcloud service.

echo "Installing all dependencies..."
MARKER_FILE="$HOME/.config/omarchy/plugins/aerorohit.nextcloud/.installed-nextcloud-client"
if ! pacman -Q nextcloud-client &>/dev/null; then
  omarchy-pkg-add nextcloud-client
  touch "$MARKER_FILE"
fi

echo "Adding Nextcloud to the bar..."
omarchy-plugin-enable aerorohit.nextcloud

echo "Starting Nextcloud..."
uwsm-app -- nextcloud --background &>/dev/null &
echo "Nextcloud runs in the background — open the ☁ widget in the bar for status and settings."
